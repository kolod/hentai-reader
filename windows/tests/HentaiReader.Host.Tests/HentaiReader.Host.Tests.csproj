<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests of the host and the parity suite (contract tests + every recorded source case). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.4.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HentaiReader.Host\HentaiReader.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RepoRoot" Value="$(RepoRoot)" />
  </ItemGroup>
</Project>
