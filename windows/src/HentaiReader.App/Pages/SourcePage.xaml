<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HentaiReader.App.Pages.SourcePage"
    AutomationProperties.AutomationId="SourceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:HentaiReader.App.Controls"
    NavigationCacheMode="Enabled">
    <Grid Padding="16,12,16,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="QueryBox" KeyDown="QueryBox_KeyDown" />
            <Button x:Name="SearchButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Click="SearchButton_Click" />
            <DropDownButton x:Name="FiltersButton" Grid.Column="2">
                <DropDownButton.Flyout>
                    <Flyout x:Name="FiltersFlyout" Placement="BottomEdgeAlignedRight" Closed="FiltersFlyout_Closed">
                        <StackPanel Spacing="12">
                            <ContentPresenter x:Name="FilterHost" />
                            <Button x:Name="ResetButton" Click="ResetButton_Click" />
                        </StackPanel>
                    </Flyout>
                </DropDownButton.Flyout>
            </DropDownButton>
        </Grid>

        <InfoBar x:Name="ErrorBar" Grid.Row="1" Severity="Error" IsClosable="False">
            <InfoBar.ActionButton>
                <Button x:Name="RetryButton" Click="RetryButton_Click" />
            </InfoBar.ActionButton>
            <InfoBar.Content>
                <HyperlinkButton x:Name="CopyDetailsButton" Click="CopyDetailsButton_Click" Margin="0,0,0,8" />
            </InfoBar.Content>
        </InfoBar>

        <GridView
            x:Name="ResultsGrid"
            Grid.Row="2"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="ResultsGrid_ItemClick"
            ContainerContentChanging="ResultsGrid_ContainerContentChanging"
            IncrementalLoadingThreshold="2">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                    <Setter Property="Margin" Value="0,0,12,16" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <controls:ResultCard />
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Padding="0,4,0,8">
            <ProgressRing x:Name="Progress" Width="16" Height="16" IsActive="False" />
            <TextBlock x:Name="StatusText" Opacity="0.7" />
        </StackPanel>
    </Grid>
</Page>
