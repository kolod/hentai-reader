{
  // Static check for `// @ts-check` source scripts (used by `source-runner check`).
  // Only ES2020 built-ins and the contract globals exist: fetch, URL, setTimeout, TextEncoder
  // are type errors, exactly as they are runtime errors in QuickJS and Jint.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2020",
    "lib": ["es2020"],
    "types": [],
    "module": "es2020",
    "moduleResolution": "bundler",
    "paths": {
      "@contract": ["./host-api.d.ts"]
    }
  },
  "files": ["host-api.d.ts"]
}
